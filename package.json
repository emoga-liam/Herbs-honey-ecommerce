{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm run typecheck && pnpm --filter @workspace/ffg-store run build && pnpm --filter @workspace/api-server run build",
    "hostinger:build": "pnpm run build",
    "hostinger:bundle": "bash ./scripts/create-hostinger-bundle.sh",
    "hostinger:start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm run -r typecheck"
  },
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
