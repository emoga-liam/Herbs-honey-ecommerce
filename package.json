{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "postinstall": "node ./scripts/fix-esbuild-bins.mjs",
    "build": "node ./scripts/prod-build.mjs",
    "hostinger:build": "node ./scripts/prod-build.mjs",
    "hostinger:bundle": "bash ./scripts/create-hostinger-bundle.sh",
    "hostinger:start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "node ./scripts/prod-typecheck.mjs"
  },
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
