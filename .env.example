# Environment variables required to run this project.
# Copy this file to .env and fill in your values (never commit .env to git).
# On Replit: add these via the Secrets panel (padlock icon).
# On Hostinger/other hosts: set them in your host's environment config panel.

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase (or any PostgreSQL) connection string (use the pooler URL for Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Server ───────────────────────────────────────────────────────────────────
# Long random string used to sign admin sessions — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── Paystack (Payments) ──────────────────────────────────────────────────────
# Secret key — server-side only (get from Paystack Dashboard → Settings → API Keys)
PAYSTACK_SECRET_KEY=sk_test_...
# Public key — needed for frontend inline checkout (get from Paystack Dashboard)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_...

# ── Firebase (Admin Authentication) ──────────────────────────────────────────
# Found in Firebase Console → Project Settings → General → Your apps → Web app config
# Also used server-side as GOOGLE_API_KEY for password change/reset calls
GOOGLE_API_KEY=AIzaSy...
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abc123

# ── Supabase (storefront public product reads) ───────────────────────────────
# Project URL + publishable (anon) key from Supabase → Project Settings → API
# These are baked into the Vite storefront at build time (required on Hostinger).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
